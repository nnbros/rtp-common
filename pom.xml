<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.nnbros.rtp</groupId>
    <artifactId>rtp-common</artifactId>
    <version>0.4.1</version>
    <packaging>pom</packaging>
    <name>rtp-common</name>
    <description>A common library for building rtp projects</description>
    <modules>
        <module>rtp-common-core</module>
        <module>rtp-common-springboot-starter</module>
        <module>rtp-common-springboot-autoconfigure</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.plugin.version>3.8.1</maven.compiler.plugin.version>
        <lombok.version>1.18.34</lombok.version>
        <junit.version>5.11.3</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <spring.boot.version>3.3.5</spring.boot.version>
        <telegrambots.version>7.9.1</telegrambots.version>
        <telegram-bot-elements.version>0.0.5</telegram-bot-elements.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.github.nnbros.rtp</groupId>
                <artifactId>rtp-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.nnbros.rtp</groupId>
                <artifactId>rtp-common-springboot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>github</id>
            <name>GitHub Guronas Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/Guronas/telegram-bot-elements</url>
        </repository>
        <repository>
            <id>rtp-common</id>
            <name>GitHub NNBros common lib</name>
            <url>https://maven.pkg.github.com/nnbros/rtp-common</url>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>rtp-common</id>
            <name>GitHub NNBros common lib</name>
            <url>https://maven.pkg.github.com/nnbros/rtp-common</url>
        </repository>
    </distributionManagement>
</project>
